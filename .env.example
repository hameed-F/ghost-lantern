PORT=3000
NODE_ENV=development
# Neon / Supabase / Render Postgres connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Long random strings. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
OTP_SECRET=
# Email (Brevo SMTP or Gmail app password). Leave empty in development to print the OTP in the terminal.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Ghost Lantern <you@example.com>"
